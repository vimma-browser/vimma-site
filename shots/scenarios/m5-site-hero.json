{
  "name": "m5-site-hero",
  "description": "The website's front-page screenshots (vimma-site, npm run shots), not a test: a work workspace with a mail tab, then on main the hero's steps, one screenshot each. Pages come from vimma-site's shots/pages through an HTTP proxy on 127.0.0.1:8139, so the URL bar shows news.example and mail.example. Dark chrome and content to match the site. Workspaces are switched with ctrl+b ( and ctrl+b ), the keys the hero shows.",
  "timeoutSeconds": 120,
  "prefs": {
    "network.proxy.type": 1,
    "network.proxy.http": "127.0.0.1",
    "network.proxy.http_port": 8139,
    "network.proxy.no_proxies_on": "",
    "security.insecure_connection_icon.enabled": false,
    "security.insecure_connection_text.enabled": false,
    "ui.systemUsesDarkTheme": 1,
    "layout.css.prefers-color-scheme.content-override": 0,
    "dom.security.https_first": false,
    "dom.security.https_first_schemeless": false,
    "dom.securecontext.allowlist": "news.example,mail.example",
    "security.insecure_connection_text.pbmode.enabled": false
  },
  "steps": [
    {
      "wait-for-state": {
        "workspace": "main"
      },
      "timeoutSeconds": 20
    },
    {
      "keys": "ctrl+b shift+n"
    },
    {
      "wait-for-state": {
        "mode": "command"
      }
    },
    {
      "keys": "w o r k enter"
    },
    {
      "wait-for-state": {
        "workspace": "work"
      }
    },
    {
      "open": "http://mail.example/"
    },
    {
      "wait-for-state": {
        "workspace": "work",
        "mode": "normal"
      }
    },
    {
      "keys": "ctrl+b ("
    },
    {
      "wait-for-state": {
        "workspace": "main"
      }
    },
    {
      "open": "http://news.example/"
    },
    {
      "wait-for-state": {
        "workspace": "main",
        "mode": "normal"
      }
    },
    {
      "screenshot": "hero-normal"
    },
    {
      "keys": "f"
    },
    {
      "wait-for-state": {
        "mode": "hint"
      }
    },
    {
      "screenshot": "hero-hints"
    },
    {
      "keys": "f"
    },
    {
      "wait-for-state": {
        "mode": "normal"
      }
    },
    {
      "screenshot": "hero-follow"
    },
    {
      "keys": "ctrl+b"
    },
    {
      "screenshot": "hero-prefix"
    },
    {
      "keys": "v"
    },
    {
      "wait-for-state": {
        "mode": "insert"
      }
    },
    {
      "screenshot": "hero-split"
    },
    {
      "keys": "ctrl+b h"
    },
    {
      "wait-for-state": {
        "mode": "normal"
      }
    },
    {
      "keys": "ctrl+b )"
    },
    {
      "wait-for-state": {
        "workspace": "work"
      }
    },
    {
      "screenshot": "hero-workspace"
    },
    {
      "keys": "ctrl+b ?"
    },
    {
      "wait-for-state": {
        "mode": "help"
      }
    },
    {
      "screenshot": "hero-help"
    }
  ]
}
