{
  // Browser side: the site's one script, and the docs search's scoring it loads with the index.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "es2020",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": ".",
    "outDir": "../../.build/site"
  },
  "include": ["site.ts", "search.ts"]
}
