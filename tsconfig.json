{
  // Node side: the build, the dev server, the checks and the keys generator.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": ".",
    "outDir": ".build",
    "skipLibCheck": true
  },
  "include": ["build.ts", "scripts/**/*.ts", "src/ts/hero.ts"]
}
