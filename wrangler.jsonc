// The vimma-site Worker as Workers Builds deploys it: static assets from dist/, and a script that
// runs first for /support/* only (Firefox's help links, scripts/worker.ts), so every other request
// is served from dist/ without it. It states what the dashboard already had (the domain,
// workers.dev, logs), so a deploy from main changes nothing else; the empty `previews` block is what `wrangler preview`, the deploy
// command for other branches, needs to build a Preview of a pull request.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vimma-site",
  "compatibility_date": "2026-10-23",
  "main": "scripts/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/support/*"]
  },
  "routes": [{ "pattern": "vimma.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "previews": {}
}
