// The vimma-site Worker: static files from dist/, served at vimma.dev.
// Workers Builds runs `wrangler deploy` on main and `wrangler versions upload` on other branches;
// the second has no dashboard flags to fall back on, so without this file PR previews failed.
// Values match the deployed Worker; change them here, not in the dashboard.
{
  "name": "vimma-site",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "vimma.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
