// The vimma-site Worker as Workers Builds deploys it: static assets from dist/, and a script that
// runs first for /support/* (Firefox's help links, scripts/worker.ts) and for the retired pages'
// addresses (scripts/redirects.ts, workerFirstPaths; a test holds the list to it), so every other
// request is served from dist/ without it. It states what the dashboard already had (the domain,
// workers.dev, logs), so a deploy from main changes nothing else; the empty `previews` block is what `wrangler preview`, the deploy
// command for other branches, needs to build a Preview of a pull request.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vimma-site",
  "compatibility_date": "2026-10-23",
  "main": "scripts/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/support/*",
      "/docs/compared",
      "/docs/compared/",
      "/docs/compared/index.html",
      "/docs/accessibility",
      "/docs/accessibility/",
      "/docs/accessibility/index.html",
      "/docs/troubleshooting",
      "/docs/troubleshooting/",
      "/docs/troubleshooting/index.html",
      "/docs/moving",
      "/docs/moving/",
      "/docs/moving/index.html",
      "/docs/copy-mode",
      "/docs/copy-mode/",
      "/docs/copy-mode/index.html"
    ],
    // Without it a missing address gets an empty 404; with it, dist/404.html.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "vimma.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "previews": {}
}
